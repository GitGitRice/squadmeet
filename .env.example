# Copy to .env to change the local database credentials. Without .env, docker-compose.yml
# uses "squadmeet" for all three. Never commit .env.
POSTGRES_USER=squadmeet
POSTGRES_PASSWORD=squadmeet
POSTGRES_DB=squadmeet

# Optional geocoding provider configuration (SCRUM-52). Search is submit-only; the backend
# enforces at most one public Nominatim request per second and caches results.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SquadMeet/1.0 (https://squadmeet.duckdns.org)

# Optional Web Push (SCRUM-44). Generate one P-256 VAPID pair; never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@squadmeet.duckdns.org
